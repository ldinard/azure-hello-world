# DealCloud OAuth2 Credentials
DEALCLOUD_CLIENT_ID=your_client_id_here
DEALCLOUD_API_KEY=your_api_key_here

# DealCloud Site URL (e.g. https://yourfirm.dealcloud.com)
DEALCLOUD_SITE_URL=https://yourfirm.dealcloud.com

# Optional: override the OAuth2 token endpoint if auto-detection is wrong.
# Defaults to ${DEALCLOUD_SITE_URL}/connect/token
# Other common values:
#   https://unifiedidentity6.dealcloud.com/connect/token
# DEALCLOUD_TOKEN_URL=https://yourfirm.dealcloud.com/connect/token

# ─── Snowflake (for DealCloud → Snowflake sync latency measurement) ───────────
# Account identifier: <orgname>-<accountname> or <locator>.<region>.<cloud>
# e.g. xy12345.us-east-1  or  myorg-myaccount
SNOWFLAKE_ACCOUNT=your_account_here
SNOWFLAKE_USERNAME=your_username_here
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_DATABASE=your_database_here
SNOWFLAKE_WAREHOUSE=your_warehouse_here

# Schema to use within the database (defaults to PUBLIC if omitted)
# SNOWFLAKE_SCHEMA=PUBLIC

# ─── Latency monitor UI defaults (exposed to the browser) ────────────────────
# The Snowflake table the latency monitor queries by default.
# Can be overridden in the UI at runtime.
# e.g. COMPANY  or  MY_DB.MY_SCHEMA.COMPANY
NEXT_PUBLIC_SNOWFLAKE_TABLE=COMPANY

# Column in the table that holds the record name / identifier.
# Must match whatever DealCloud syncs the "Name" field to in Snowflake.
NEXT_PUBLIC_SNOWFLAKE_COLUMN=NAME
